# .env.example — copy to .env and fill in locally. NEVER commit .env.

SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Techvoto <noreply@techvoto.example>
CONTACT_EMAIL=support@techvoto.example

# Refund policy
REFUND_WINDOW_DAYS=7
REFUND_MAX_PROGRESS=30

# Paystack — set to a TEST key locally, LIVE key only in prod secret store
PAYSTACK_SECRET_KEY=

# Jitsi / 8x8 JaaS — LEAVE EMPTY unless you are actively using JaaS
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=
JITSI_KID=
JITSI_APP_SECRET=
JITSI_PRIVATE_KEY_PATH=

# Seed
SEED_PASSWORD=

# Redis / Celery
CACHE_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=django-db://

# Cookies
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=techvoto@3.1.0
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO
NUM_PROXIES=2
EXPOSE_API_DOCS=False